# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin.
# docker-compose.yml, aynı klasördeki .env dosyasını otomatik okur.
# .env asla git'e eklenmez (.gitignore'da).

# openssl rand -hex 32 ile üretin. Admin oturum çerezini imzalamak için kullanılır.
ADMIN_SESSION_SECRET=

# iyzico ödeme entegrasyonu
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Sitenin dışarıdan erişilen adresi (iyzico callback URL'i için)
PUBLIC_BASE_URL=http://localhost:8080
